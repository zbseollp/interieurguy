---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Op InterieurGuy.nl lees je alles over de nieuwste trends op het gebied van wonen en leven. Ook vergelijken wij de populairste woonartikelen.',
  image,
} = Astro.props;

const fullTitle =
  title === 'Home'
    ? 'InterieurGuy.nl - de populairste interieurwebsite voor mannen!'
    : `${title} | InterieurGuy.nl`;
---
<!doctype html>
<html lang="nl-NL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/2023/11/cropped-Favicon-interieurguy-32x32.png" />
    <link rel="apple-touch-icon" href="/images/2023/11/cropped-Favicon-interieurguy-180x180.png" />
    {image && <meta property="og:image" content={image} />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <a href="#content" class="skip-link">Ga naar de inhoud</a>
    <slot name="header" />
    <main id="content">
      <slot />
    </main>
    <slot name="footer" />
    <script>
      function markVisible(el) {
        el.classList.add('is-visible');
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              markVisible(entry.target);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.reveal').forEach((el) => {
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          markVisible(el);
        } else {
          observer.observe(el);
        }
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
  @import '../styles/navigation.css';
  @import '../styles/footer.css';

  body.nav-open {
    overflow: hidden;
  }

  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
