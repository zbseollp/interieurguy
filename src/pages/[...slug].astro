---
import { getCollection, render } from 'astro:content';
import { allSiteSlugs, getPage, getCategoryItems } from '../data/pages';
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  const pageEntries = await getCollection('pages');

  const blogPaths = blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { type: 'blog' as const, entry },
  }));

  const pagePaths = pageEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { type: 'page' as const, entry },
  }));

  const covered = new Set([
    ...blogEntries.map((e) => e.id),
    ...pageEntries.map((e) => e.id),
    'contact',
    'blog',
    'home',
    'laatste-berichten',
    'sitemap',
  ]);

  const legacyPaths = allSiteSlugs
    .filter((slug) => !covered.has(slug))
    .map((slug) => ({
      params: { slug },
      props: { type: 'legacy' as const, slug },
    }));

  return [...blogPaths, ...pagePaths, ...legacyPaths];
}

const props = Astro.props;

function createFallbackPage(slug: string) {
  const title = slug
    .replace(/^beste-/, '')
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');

  const isProduct = slug.startsWith('beste-');

  return {
    slug,
    title: isProduct ? `Beste ${title}` : title,
    description: `Lees alles over ${title.toLowerCase()} op InterieurGuy.nl.`,
    featuredImage: '/images/2023/07/1-2.jpg',
    content: `<p>Welkom op InterieurGuy.nl. In dit artikel delen we onze tips en ervaringen over ${title.toLowerCase()}. Bekijk regelmatig onze site voor de nieuwste productvergelijkingen en interieurtips.</p>`,
  };
}

const categoryHubs = [
  'meubels',
  'slaapkamer',
  'elektrische-apparaten',
  'veiligheid',
  'rekken-en-manden',
  'decoratie',
  'luchtkoelers-en-verwarmers',
];

const legacyPage =
  props.type === 'legacy'
    ? getPage(props.slug) ?? createFallbackPage(props.slug)
    : null;

const categoryItems =
  props.type === 'page' ? getCategoryItems(props.entry.id) : [];

const isCategoryHub =
  props.type === 'page' && categoryHubs.includes(props.entry.id);

const { Content } =
  props.type === 'blog' || props.type === 'page'
    ? await render(props.entry)
    : { Content: null };
---
{props.type === 'blog' && Content && (
  <BlogPostLayout entry={props.entry}>
    <Header slot="header" />
    <Content />
    <Footer slot="footer" />
  </BlogPostLayout>
)}

{props.type === 'page' && Content && (
  <ContentPageLayout entry={props.entry}>
    <Header slot="header" />
    <Content />
    {isCategoryHub && categoryItems.length > 0 && (
      <div class="container category-grid">
        <div class="card-grid">
          {categoryItems.map((item) => (
            <ArticleCard
              slug={item.href.replace(/^\/|\/$/g, '')}
              title={item.title}
              image={item.image}
              alt={item.alt}
            />
          ))}
        </div>
      </div>
    )}
    <Footer slot="footer" />
  </ContentPageLayout>
)}

{props.type === 'legacy' && legacyPage && (
  <ArticleLayout
    title={legacyPage.title}
    description={legacyPage.description}
    image={legacyPage.featuredImage}
  >
    <Header slot="header" />
    <div set:html={legacyPage.content} />
    <Footer slot="footer" />
  </ArticleLayout>
)}

<style>
  .category-grid {
    padding-bottom: 3rem;
  }
</style>
