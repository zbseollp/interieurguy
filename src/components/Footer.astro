---
import {
  footerInfoLinks,
  footerCategoryLinks,
  footerColumnHeadings,
  footerTagline,
  footerLatestPostSlugs,
  footerCtaBackground,
} from '../data/footer';
import { ctaSection } from '../data/homepage';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const postsBySlug = new Map(allPosts.map((post) => [post.id, post]));
const blogPosts = footerLatestPostSlugs
  .map((slug) => postsBySlug.get(slug))
  .filter((post): post is NonNullable<typeof post> => post !== undefined);

const year = new Date().getFullYear();
const footerLogo = '/images/2023/01/InterieurGuy.nl2_.svg';

const socialIcons = [
  { label: 'Facebook', icon: 'facebook' },
  { label: 'Instagram', icon: 'instagram' },
  { label: 'Twitter', icon: 'twitter' },
  { label: 'Youtube', icon: 'youtube' },
] as const;
---
<footer class="site-footer">
  <section
    class="site-footer__cta"
    style={`background-image: url('${footerCtaBackground}')`}
  >
    <div class="site-footer__cta-overlay" aria-hidden="true"></div>
    <div class="container site-footer__cta-container">
      <div class="site-footer__cta-spacer" aria-hidden="true"></div>
      <div class="site-footer__cta-content reveal">
        <p>{ctaSection.description}</p>
        <a href={ctaSection.ctaHref} class="btn btn--accent">{ctaSection.ctaLabel}</a>
      </div>
    </div>
  </section>

  <div class="container site-footer__main">
    <div class="site-footer__sidebar reveal">
      <a href="/" class="site-footer__logo" aria-label="InterieurGuy.nl Home">
        <img src={footerLogo} alt="InterieurGuy.nl" width="170" height="26" loading="lazy" />
      </a>
      <p class="site-footer__tagline">{footerTagline}</p>
      <p class="site-footer__quick-link">
        <a href="/sitemap/"><strong>Sitemap</strong></a>
      </p>
      <p class="site-footer__quick-link">
        <a href="/blog/"><strong>Blog</strong></a>
      </p>
      <div class="site-footer__social" aria-label="Social media">
        {socialIcons.map(({ label, icon }) => (
          <span class="site-footer__social-item" role="listitem">
            <a class="site-footer__social-link" target="_blank" aria-label={label}>
              {icon === 'facebook' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              )}
              {icon === 'instagram' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              )}
              {icon === 'twitter' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              )}
              {icon === 'youtube' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              )}
            </a>
          </span>
        ))}
      </div>
      <p class="site-footer__copyright">&copy; {year} Alle rechten voorbehouden</p>
    </div>

    <div class="site-footer__grid">
      <div class="site-footer__column reveal">
        <p class="site-footer__heading">Informatie</p>
        <div class="site-footer__links">
          {footerInfoLinks.map((link) => (
            <p><a href={link.href}>{link.label}</a></p>
          ))}
        </div>
      </div>

      <div class="site-footer__column reveal">
        <p class="site-footer__heading">Laatste artikelen</p>
        <div class="site-footer__links">
          {blogPosts.map((post) => (
            <p><a href={`/${post.id}/`}>{post.data.title}</a></p>
          ))}
        </div>
      </div>

      <div class="site-footer__column reveal">
        <p class="site-footer__heading">
          <a href={footerColumnHeadings.veiligheid.href}>{footerColumnHeadings.veiligheid.label}</a>
        </p>
        <div class="site-footer__links">
          {footerCategoryLinks.veiligheid.map((link) => (
            <p><a href={link.href}>{link.label}</a></p>
          ))}
        </div>
      </div>

      <div class="site-footer__column reveal">
        <p class="site-footer__heading">
          <a href={footerColumnHeadings.rekkenManden.href}>{footerColumnHeadings.rekkenManden.label}</a>
        </p>
        <div class="site-footer__links">
          {footerCategoryLinks.rekkenManden.map((link) => (
            <p><a href={link.href}>{link.label}</a></p>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
