---
import { categoryLinks } from '../data/homepage';
---
<section class="features section--soft section--sm reveal">
  <div class="container">
    <div class="features__grid">
      {categoryLinks.map((item) => (
        <a href={item.href} class="features__item">
          <img src={item.icon} alt="" width="48" height="48" loading="lazy" />
          <span>{item.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .features__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(0.75rem, 2vw, 1.25rem);
    background: var(--color-bg-soft);
    border-radius: var(--card-radius);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .features__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
    padding: 0.75rem 0.5rem;
    border-radius: var(--card-radius-sm);
    transition: background var(--transition), transform var(--transition);
  }

  .features__item img {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  .features__item span {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-primary);
    text-transform: capitalize;
    line-height: 1.3;
  }

  .features__item:hover {
    background: rgba(223, 181, 108, 0.12);
    transform: translateY(-3px);
  }

  @media (max-width: 1023px) {
    .features__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 479px) {
    .features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
