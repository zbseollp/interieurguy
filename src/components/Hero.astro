---
import { heroContent } from '../data/homepage';
---
<section
  class="hero reveal"
  style={`background-image: url('${heroContent.backgroundImage}')`}
>
  <div class="container hero__inner">
    <div class="hero__grid">
      <div class="hero__content">
        <h1>{heroContent.title}</h1>
        <p>{heroContent.description}</p>
      </div>
      <div class="hero__spacer" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    background-color: #fcfcfc;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero__inner {
    padding: 110px 0 230px;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    min-height: clamp(280px, 36vw, 420px);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-radius: 16px 0 0 16px;
    padding: 10px;
  }

  .hero__content h1 {
    color: #313131;
    font-size: clamp(2rem, 3.75vw, 3rem);
    font-weight: 400;
    line-height: 1;
    margin: 0 0 1rem;
  }

  .hero__content p {
    color: #313131;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    margin: 0;
    max-width: 36rem;
  }

  .hero__spacer {
    min-height: 100%;
  }

  @media (max-width: 1023px) {
    .hero__inner {
      padding: 72px 0 120px;
    }
  }

  @media (max-width: 767px) {
    .hero__inner {
      padding: 36px 0 80px;
    }

    .hero__grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero__content {
      border-radius: 16px 16px 0 0;
      padding-bottom: 1.5rem;
    }

    .hero__spacer {
      min-height: 220px;
    }
  }
</style>
